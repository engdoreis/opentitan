name: "lowrisc:dv:top_peppermint_chip_env:0.1"
description: "Peppermint top-level DV UVM environment"
filesets:
  files_dv:
    depend:
      - lowrisc:opentitan:bus_params_pkg
      - lowrisc:dv:cip_lib
      - lowrisc:dv:dv_utils
      - lowrisc:dv:dv_lib
      # -- TODO: JTAG/DMI transport, unused until chip_env sets jtag_riscv_map -----
      # - lowrisc:ip:jtag_pkg
      # - lowrisc:dv:jtag_agent
      # - lowrisc:dv:jtag_riscv_agent
      # - lowrisc:dv:jtag_dmi_agent
      - lowrisc:dv:mem_bkdr_util
      - lowrisc:dv:rom_ctrl_bkdr_util
      - lowrisc:dv:sram_ctrl_bkdr_util
      - lowrisc:peppermint_dv:otp_ctrl_mem_bkdr_util
      - lowrisc:ip:lc_ctrl_state_pkg
      - lowrisc:peppermint_constants:testing_rnd_cnst_pkg
      - lowrisc:dv:sw_test_status
      - lowrisc:dv:sw_logger_if
      - lowrisc:dv:top_peppermint_chip_ral
      - lowrisc:systems:top_peppermint_pkg
      - lowrisc:peppermint_constants:top_pkg
      - lowrisc:top_peppermint:xbar_main
      - lowrisc:peppermint_ip:rv_core_ibex
      - lowrisc:top_peppermint:ahb_bridge
      - lowrisc:ip:lc_ctrl_pkg
      - lowrisc:ip:tlul
      - lowrisc:prim:alert
      - lowrisc:prim:mubi_pkg
      # -- TODO: reused AHB manager agent (Caliptra PR #1312) ------------------
      # - chipsalliance:caliptra:ahb_agent
      # -- TODO: AHB subordinate + memory-model agent -------------------
      # - lowrisc:dv:ahb_sub_agent
    files:
      - chip_common_pkg.sv
      - chip_if.sv
      - chip_env_pkg.sv
      - chip_env_cfg.sv: {is_include_file: true}
      - chip_env_cov.sv: {is_include_file: true}
      - chip_virtual_sequencer.sv: {is_include_file: true}
      - chip_scoreboard.sv: {is_include_file: true}
      - chip_env.sv: {is_include_file: true}
      - seq_lib/chip_vseq_list.sv: {is_include_file: true}
      - seq_lib/chip_base_vseq.sv: {is_include_file: true}
      - seq_lib/chip_stub_cpu_csr_access_vseq.sv: {is_include_file: true}
      # topgen-emitted NUM_ALERTS / LIST_OF_ALERTS, included by chip_common_pkg
      - autogen/chip_env_pkg__params.sv: {is_include_file: true}
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_dv
