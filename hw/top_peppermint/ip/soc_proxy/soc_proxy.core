name: "lowrisc:top_peppermint:soc_proxy:0.1"
description: "SoC proxy: pass-through placeholder for the future TL-UL->AHB egress bridge"

filesets:
  files_rtl:
    depend:
      - lowrisc:ip:tlul
    files:
      - rtl/soc_proxy.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - files_rtl
    toplevel: soc_proxy
