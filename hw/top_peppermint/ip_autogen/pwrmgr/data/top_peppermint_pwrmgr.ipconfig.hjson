{
  instance_name: top_peppermint_pwrmgr
  param_values:
  {
    NumWkups: 1
    Wkups:
    [
      {
        name: wkup_req
        width: "1"
        module: soc
      }
    ]
    NumRstReqs: 1
    rst_reqs:
    {
      int:
      [
        {
          name: MainPwr
          desc: main power glitch reset request
          module: pwrmgr
        }
        {
          name: Esc
          desc: escalation reset request
          module: alert_handler
        }
      ]
      debug:
      [
        {
          name: Ndm
          desc: non-debug-module reset request
          module: rv_dm
        }
      ]
      peripheral:
      [
        {
          name: rst_req
          width: "1"
          module: soc
          desc: External reset request from the SoC
          enabled_after_reset: true
        }
      ]
    }
    wait_for_external_reset: false
    NumRomInputs: 1
    has_aon_clk: true
    src_clks:
    [
      main
    ]
    topname: peppermint
    uniquified_modules: {}
    module_instance_name: pwrmgr
  }
}
