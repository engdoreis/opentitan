{
  instance_name: top_peppermint_clkmgr
  param_values:
  {
    ext_clk_bypass: false
    src_clks:
    {
      main:
      {
        name: main
        aon: false
        freq: 400000000
        ref: false
      }
      aon:
      {
        name: aon
        aon: true
        freq: 32768
        ref: true
      }
    }
    derived_clks: {}
    typed_clocks:
    {
      ast_clks:
      {
        clk_aon_i:
        {
          src_name: aon
          endpoint_ip: pwrmgr
        }
        clk_main_i:
        {
          src_name: main
          endpoint_ip: pwrmgr
        }
      }
      ft_clks:
      {
        clk_aon_secure:
        {
          src_name: aon
          endpoint_ip: rv_core_ibex
        }
      }
      rg_clks:
      {
        clk_main_secure:
        {
          src_name: main
          endpoint_ip: alert_handler
        }
      }
      sw_clks: {}
      hint_clks: {}
    }
    hint_names: {}
    parent_child_clks:
    {
      main:
      [
        main
      ]
    }
    exported_clks: {}
    number_of_clock_groups: 2
    with_alert_handler: true
    topname: peppermint
    uniquified_modules: {}
    module_instance_name: clkmgr
  }
}
