{
  instance_name: top_peppermint_rstmgr
  param_values:
  {
    clk_freqs:
    {
      aon: 32768
      main: 400000000
    }
    reqs:
    {
      int:
      [
        {
          name: MainPwr
          desc: main power glitch reset request
          module: pwrmgr
        }
        {
          name: Esc
          desc: escalation reset request
          module: alert_handler
        }
      ]
      debug:
      [
        {
          name: Ndm
          desc: non-debug-module reset request
          module: rv_dm
        }
      ]
      peripheral:
      [
        {
          name: rst_req
          width: "1"
          module: soc
          desc: External reset request from the SoC
          enabled_after_reset: true
        }
      ]
    }
    power_domains:
    [
      Aon
      Main
    ]
    num_rstreqs: 1
    sw_rsts:
    {
      soc_cpu: aon
    }
    output_rsts:
    [
      {
        name: por_aon
        gen: false
        type: top
        domains:
        [
          Aon
          Main
        ]
        shadowed: false
        sw: false
        path: rst_por_aon_n
        clock: aon
      }
      {
        name: por_main
        gen: true
        type: top
        domains:
        [
          Aon
        ]
        shadowed: false
        sw: false
        path: rst_por_main_n
        parent: por_aon
        clock: main
      }
      {
        name: sys
        gen: true
        type: top
        domains:
        [
          Main
        ]
        shadowed: false
        sw: false
        path: rst_sys_n
        parent: sys_src
        clock: main
      }
      {
        name: lc_main
        gen: true
        type: top
        domains:
        [
          Main
          Aon
        ]
        shadowed: true
        sw: false
        path: rst_lc_main_n
        parent: lc_src
        clock: main
      }
      {
        name: lc_aon
        gen: true
        type: top
        domains:
        [
          Main
          Aon
        ]
        shadowed: true
        sw: false
        path: rst_lc_aon_n
        parent: lc_src
        clock: aon
      }
      {
        name: soc_cpu
        gen: true
        type: top
        domains:
        [
          Aon
        ]
        shadowed: false
        sw: true
        path: rst_soc_cpu_n
        parent: lc_src
        clock: aon
      }
    ]
    leaf_rsts:
    [
      {
        name: por_main
        gen: true
        type: top
        domains:
        [
          Aon
        ]
        shadowed: false
        sw: false
        path: rst_por_main_n
        parent: por_aon
        clock: main
      }
      {
        name: sys
        gen: true
        type: top
        domains:
        [
          Main
        ]
        shadowed: false
        sw: false
        path: rst_sys_n
        parent: sys_src
        clock: main
      }
      {
        name: lc_main
        gen: true
        type: top
        domains:
        [
          Main
          Aon
        ]
        shadowed: true
        sw: false
        path: rst_lc_main_n
        parent: lc_src
        clock: main
      }
      {
        name: lc_aon
        gen: true
        type: top
        domains:
        [
          Main
          Aon
        ]
        shadowed: true
        sw: false
        path: rst_lc_aon_n
        parent: lc_src
        clock: aon
      }
      {
        name: soc_cpu
        gen: true
        type: top
        domains:
        [
          Aon
        ]
        shadowed: false
        sw: true
        path: rst_soc_cpu_n
        parent: lc_src
        clock: aon
      }
    ]
    rst_ni: lc_aon
    export_rsts: {}
    with_alert_handler: true
    topname: peppermint
    uniquified_modules: {}
    module_instance_name: rstmgr
  }
}
