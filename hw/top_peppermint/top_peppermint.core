name: "lowrisc:systems:top_peppermint:0.1"
description: "Technology-independent Peppermint toplevel"
filesets:
  files_rtl_generic:
    depend:
      # Place the autogen packages first to avoid conflicts
      - lowrisc:peppermint_constants:top_racl_pkg
      - lowrisc:peppermint_ip:alert_handler_reg
      - lowrisc:peppermint_ip:otp_ctrl_macro_pkg
      - lowrisc:peppermint_ip:otp_ctrl_top_specific_pkg
      - lowrisc:peppermint_ip:pwrmgr_pkg
      - lowrisc:ip:rv_dm
      - lowrisc:ip:rv_timer
      - lowrisc:ip:tlul
      - lowrisc:ip:aes
      - lowrisc:ip:entropy_src
      - lowrisc:ip:csrng
      - lowrisc:ip:edn
      - lowrisc:ip:dma
      - lowrisc:ip:hmac
      - lowrisc:ip:kmac
      - lowrisc:ip:otbn
      - lowrisc:ip:otp_macro
      - lowrisc:prim:ram_1p_scr
      - lowrisc:ip:sram_ctrl
      - lowrisc:ip:keymgr_dpe
      - lowrisc:peppermint_constants:top_pkg
      - lowrisc:constants:top_peppermint_ibex_pmp_reset_pkg
      - lowrisc:ip:lc_ctrl
      - lowrisc:ip:mbx
      - lowrisc:top_peppermint:xbar_main
      - lowrisc:top_peppermint:xbar_socdbg
      - lowrisc:top_peppermint:xbar_socmbx
      - lowrisc:peppermint_ip:alert_handler
      - lowrisc:peppermint_ip:clkmgr
      - lowrisc:peppermint_ip:otp_ctrl
      - lowrisc:peppermint_ip:pwrmgr
      - lowrisc:peppermint_ip:rstmgr
      - lowrisc:peppermint_ip:rv_plic
      - lowrisc:peppermint_ip:rv_core_ibex
      - lowrisc:ip:rom_ctrl
      - lowrisc:top_peppermint:ahb_bridge
      - lowrisc:tlul:headers
      - lowrisc:prim:all
      - lowrisc:prim:mubi
      - lowrisc:systems:top_peppermint_pkg
      - lowrisc:systems:ast_pkg
    files:
      - rtl/autogen/top_peppermint_racl_pkg.sv
      - rtl/autogen/top_peppermint.sv
      - rtl/autogen/peppermint_pd_main.sv
      - rtl/autogen/peppermint_pd_aon.sv
    file_type: systemVerilogSource

  files_rtl_testing:
    depend:
      - lowrisc:peppermint_constants:testing_rnd_cnst_pkg
      - lowrisc:peppermint_constants:testing_lc_ctrl_token_pkg

  files_rtl_tapeout:
    depend:
      - lowrisc:peppermint_constants:tapeout_rnd_cnst_pkg
      - lowrisc:peppermint_constants:tapeout_lc_ctrl_token_pkg

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/top_peppermint.vlt
    file_type: vlt

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/top_peppermint.waiver
    file_type: waiver

  files_veriblelint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    files:
      - lint/top_peppermint.vbl
    file_type: veribleLintWaiver

mapping:
  "lowrisc:virtual_constants:top_pkg": "lowrisc:peppermint_constants:top_pkg"
  "lowrisc:virtual_constants:top_racl_pkg": "lowrisc:peppermint_constants:top_racl_pkg"
  "lowrisc:systems:ast_pkg": "lowrisc:systems:top_peppermint_ast_pkg"
  "lowrisc:virtual_constants:lc_ctrl_token_pkg": "lowrisc:peppermint_constants:testing_lc_ctrl_token_pkg"
  "lowrisc:virtual_constants:rnd_cnst_pkg": "lowrisc:peppermint_constants:testing_rnd_cnst_pkg"

parameters:
  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine

targets:
  default: &default_target
    filesets:
      - tool_verilator    ? (files_verilator_waiver)
      - tool_ascentlint   ? (files_ascentlint_waiver)
      - tool_veriblelint  ? (files_veriblelint_waiver)
      - fileset_tapeout   ? (files_rtl_tapeout)
      - "!fileset_tapeout ? (files_rtl_testing)"
      - files_rtl_generic
    toplevel: top_peppermint

  sim:
    default_tool: verilator
    filesets:
      - fileset_tapeout   ? (files_rtl_tapeout)
      - "!fileset_tapeout ? (files_rtl_testing)"
      - files_rtl_generic
    toplevel: top_peppermint

  syn:
    <<: *default_target
    default_tool: icarus
    parameters:
      - SYNTHESIS=true
    toplevel: top_peppermint

  lint:
    <<: *default_target
    default_tool: verilator
    parameters:
      - SYNTHESIS=true
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"
