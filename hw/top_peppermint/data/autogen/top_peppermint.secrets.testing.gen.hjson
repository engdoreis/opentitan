            [
              {
                name: AUTH_SLOT_STATE_ROT_FIRMWARE
                size: 16
                desc:
                  '''
                  RoT Firmware Auth Slot State
                  SLOT_ST_RAW:       slot not yet claimed (factory default)
                  SLOT_ST_LOCKED0:   first slot claimed
                  SLOT_ST_RELEASED0: first slot released (assets have been cleared, ready to xfer)
                  SLOT_ST_LOCKED1:   second slot claimed
                  SLOT_ST_RELEASED1: second slot released (assets have been cleared, ready to xfer)
                  SLOT_ST_LOCKED2:   third slot claimed
                  SLOT_ST_RELEASED2: third slot released (assets have been cleared, ready to xfer)
                  SLOT_ST_LOCKED3:   fourth slot claimed
                  SLOT_ST_SCRAPPED:  scrap state - terminal
                  '''
                isdigest: false
                iszer: false
                ismubi: false
                iskeymgr_creator: false
                iskeymgr_owner: false
                inv_default: 0
                offset: 832
              }
              {
                name: AUTH_SLOT_STATE_SOC_FIRMWARE
                size: 16
                desc:
                  '''
                  SoC Firmware Key Slot State
                  SLOT_ST_RAW:       slot not yet claimed (factory default)
                  SLOT_ST_LOCKED0:   first slot claimed
                  SLOT_ST_RELEASED0: first slot released (assets have been cleared, ready to xfer)
                  SLOT_ST_LOCKED1:   second slot claimed
                  SLOT_ST_RELEASED1: second slot released (assets have been cleared, ready to xfer)
                  SLOT_ST_LOCKED2:   third slot claimed
                  SLOT_ST_RELEASED2: third slot released (assets have been cleared, ready to xfer)
                  SLOT_ST_LOCKED3:   fourth slot claimed
                  SLOT_ST_SCRAPPED:  scrap state - terminal
                  '''
                isdigest: false
                iszer: false
                ismubi: false
                iskeymgr_creator: false
                iskeymgr_owner: false
                inv_default: 0
                offset: 848
              }
            ]
            desc:
              '''
              SW managed authentication slot states partition.

              Multibit enable value for the tracking the authentication slot states.
              Note that the states can be written multiple times in a device lifetime.
              The values to be written are engineered in the same way as the LC_CTRL
              state encoding words so that the ECC encoding remains valid even after
              updating the values.

              The constants can be found in the lc_ctrl_state_pkg.sv package.

              The programming order has to adhere to:

              SLOT_ST_RAW (factory all-zero state) ->
              SLOT_ST_LOCKED0 ->
              SLOT_ST_RELEASED0 ->
              ...
              SLOT_ST_SCRAPPED

              Note that if there are less than 4 slots available the higher slot states
              become logically equivalent to SLOT_ST_SCRAPPED (firmware has to handle
              this correctly).
              '''
            iskeymgr_creator: false
            iskeymgr_owner: false
            ignore_read_lock_in_rma: false
            size: 32
            offset: 832
