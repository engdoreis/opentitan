          struct: keymgr_dpe_creator_seed
          package: keymgr_dpe_pkg
          type: uni
          act: req
          width: 1
          default: "'0"
          inst_name: otp_ctrl
          end_idx: -1
          top_type: broadcast
          top_signame: otp_ctrl_keymgr_creator_seed
          index: -1
        }
        {
          name: keymgr_owner_seed
