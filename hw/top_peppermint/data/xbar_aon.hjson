//
// Aon-domain register crossbar: connects the Aon-resident modules to the
// main crossbar through a single async link (see the "aon" node in
// xbar_main.hjson).
{ name: "aon",
  type: "xbar",
  clock_primary: "clk_aon_i", // Main clock, used in sockets
  other_clock_list: [] // Secondary clocks used by specific nodes
  reset_primary: "rst_aon_ni", // Main reset, used in sockets
  other_reset_list: [] // Secondary resets used by specific nodes

  nodes: [
    { name: "main",                   type: "host",   addr_space: "hart", clock: "clk_aon_i", reset: "rst_aon_ni", pipeline: false },
    { name: "pwrmgr",                 type: "device", clock: "clk_aon_i", reset: "rst_aon_ni", pipeline: false },
    { name: "rstmgr",                 type: "device", clock: "clk_aon_i", reset: "rst_aon_ni", pipeline: false },
    { name: "clkmgr",                 type: "device", clock: "clk_aon_i", reset: "rst_aon_ni", pipeline: false },
    { name: "alert_handler",          type: "device", clock: "clk_aon_i", reset: "rst_aon_ni", pipeline: false },
    { name: "sram_ctrl_ret.regs", type: "device", clock: "clk_aon_i", reset: "rst_aon_ni", pipeline: false },
    { name: "sram_ctrl_ret.ram",  type: "device", clock: "clk_aon_i", reset: "rst_aon_ni", pipeline: false },
  ],
  connections: {
    main: [ "pwrmgr", "rstmgr", "clkmgr", "alert_handler", "sram_ctrl_ret.regs", "sram_ctrl_ret.ram" ],
  },
}
