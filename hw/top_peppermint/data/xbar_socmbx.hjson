//
// SoC-facing mailbox window: the external SoC reaches mbx0/mbx1's "soc"
// ports through the ahb_bridge. The bridge's TL-UL host interface
// (ahb_bridge.socmbx) is this crossbar's host, fed by the incoming AHB
// subordinate port at the chip boundary.
{ name: "socmbx",
  type: "xbar",
  clock_primary: "clk_main_i",
  other_clock_list: []
  reset_primary: "rst_main_ni",
  other_reset_list: []

  nodes: [
    { name: "ahb_bridge.socmbx", type: "host", addr_space: "soc_mbx", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "mbx0.soc",          type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "mbx1.soc",          type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
  ],
  connections: {
    "ahb_bridge.socmbx": [ "mbx0.soc", "mbx1.soc" ],
  },
}
