//
// Alerts from the wider SoC into Peppermint's alert handler. The SoC side
// drives these with prim_alert_sender instances (async mode).
//
// 32 recoverable and 8 fatal alert inputs are reserved for the SoC.
//
// The inputs are spread over eight SoC low-power groups (LPGs) so that alert
// senders in different SoC clock and reset domains can be gated
// independently.  Currently, the mapping is as follows:
// - For 0 <= i <= 7, LPG i holds soc_recov_alert_[4*i] to
//   soc_recov_alert_[4*i+3].
// - For 0 <= i <= 3, LPG i holds soc_fatal_alert[2*i] and
//   soc_fatal_alert[2*i+1].
//
// This mapping can be changed based on the requirements of the SoC; it was
// chosen mainly to reserve 8 LPGs on the interfaces and come up with a
// distribution that is statistically sensible.

{
    soc: [
        {
            name: soc_recov_alert_0
            module_name: soc
            index: 0
            type: alert
            async: 1
            width: 1
            lpg_idx: 0
        }
        {
            name: soc_recov_alert_1
            module_name: soc
            index: 1
            type: alert
            async: 1
            width: 1
            lpg_idx: 0
