{ name: "main",
  type: "xbar",
  clock_primary: "clk_main_i", // Main clock, used in sockets
  other_clock_list: [ "clk_aon_i" ] // Secondary clocks used by specific nodes
  reset_primary: "rst_main_ni", // Main reset, used in sockets
  other_reset_list: [ "rst_aon_ni" ] // Secondary resets used by specific nodes

  // Rationale for pipeline and req/rsp_fifo_pass:
  // For host interfaces that are used during production state (corei/cored),
  // minimize the amount of host introduced latency.  This is accomplished
  // by setting pipeline to false.
  // For host interfaces that are only used for debug, relax the timing by
  // inserting a register slice and not allowing passthrough (more access
  // latency. This is accomplished by setting `req/rsp_fifo_pass` to false,
  // and implicitly using the default of pipeline true.
  //
  // For device interfaces, especially configuration registers, latency is
  // not generally a concern, thus use `req/rsp_fifo_pass` false and pipeline
  // true.
  // For device accesses to memories (ram / rom / flash), performance is a concern,
  // so use pipeline false where permissible by timing. If not, find a combination
  // that works.
  nodes: [
    // CPU hosts.
    { name: "rv_core_ibex.corei", type: "host", addr_space: "hart", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "rv_core_ibex.cored", type: "host", addr_space: "hart", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    // Debug module system-bus access.
    { name: "rv_dm.sba",          type: "host", addr_space: "hart", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    // DMA's crossbar-facing host port.
    { name: "dma.host",           type: "host", addr_space: "hart", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    // Mailboxes' host ports into the shared main SRAM message buffer.
    { name: "mbx0.sram",          type: "host", addr_space: "hart", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "mbx1.sram",          type: "host", addr_space: "hart", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },

    { name: "rv_dm.regs",         type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "rv_dm.mem",          type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "rom_ctrl.rom",       type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "rom_ctrl.regs",      type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "sram_ctrl_main.regs",type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "sram_ctrl_main.ram", type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "otp_ctrl.core",      type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "otp_macro.prim",     type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "lc_ctrl.regs",       type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "rv_plic",            type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "rv_timer",           type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "aes",                type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "hmac",               type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "kmac",               type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "otbn",               type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "keymgr_dpe",         type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "csrng",              type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "entropy_src",        type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "edn0",               type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "edn1",               type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "rv_core_ibex.cfg",   type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "dma",                type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    // Shared, address-mapped egress window to the wider SoC.
    { name: "ahb_bridge.ctn",     type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "mbx0.core",          type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    { name: "mbx1.core",          type: "device", clock: "clk_main_i", reset: "rst_main_ni", pipeline: false },
    // Aon-resident modules. Each keeps its own clk_aon_i/rst_aon_ni, so the
    // async crossing FIFO is generated per node, here in the main power domain.
    { name: "pwrmgr",             type: "device", clock: "clk_aon_i", reset: "rst_aon_ni", pipeline: false },
    { name: "rstmgr",             type: "device", clock: "clk_aon_i", reset: "rst_aon_ni", pipeline: false },
    { name: "clkmgr",             type: "device", clock: "clk_aon_i", reset: "rst_aon_ni", pipeline: false },
    { name: "alert_handler",      type: "device", clock: "clk_aon_i", reset: "rst_aon_ni", pipeline: false },
    { name: "sram_ctrl_ret.regs", type: "device", clock: "clk_aon_i", reset: "rst_aon_ni", pipeline: false },
    { name: "sram_ctrl_ret.ram",  type: "device", clock: "clk_aon_i", reset: "rst_aon_ni", pipeline: false },
  ],
  connections: {
    "rv_core_ibex.corei": [
      "rv_dm.mem", "rom_ctrl.rom", "rom_ctrl.regs", "sram_ctrl_main.ram",
    ],
    "rv_core_ibex.cored": [
      "rv_dm.regs", "rv_dm.mem",
      "rom_ctrl.rom", "rom_ctrl.regs",
      "sram_ctrl_main.regs", "sram_ctrl_main.ram",
      "otp_ctrl.core", "otp_macro.prim", "lc_ctrl.regs",
      "rv_plic", "rv_timer", "aes", "hmac", "kmac", "otbn", "keymgr_dpe",
      "csrng", "entropy_src", "edn0", "edn1",
      "rv_core_ibex.cfg", "dma", "ahb_bridge.ctn", "mbx0.core", "mbx1.core",
      "pwrmgr", "rstmgr", "clkmgr", "alert_handler",
      "sram_ctrl_ret.regs", "sram_ctrl_ret.ram",
    ],
    "rv_dm.sba": [
      "rv_dm.regs", "rom_ctrl.rom", "rom_ctrl.regs",
      "sram_ctrl_main.regs", "sram_ctrl_main.ram",
      "otp_ctrl.core", "otp_macro.prim", "lc_ctrl.regs",
      "rv_plic", "rv_timer", "aes", "hmac", "kmac", "otbn", "keymgr_dpe",
      "csrng", "entropy_src", "edn0", "edn1",
      "rv_core_ibex.cfg", "dma", "mbx0.core", "mbx1.core",
      "pwrmgr", "rstmgr", "clkmgr", "alert_handler",
      "sram_ctrl_ret.regs", "sram_ctrl_ret.ram",
    ],
    "dma.host": [
      "sram_ctrl_main.ram", "rom_ctrl.rom", "ahb_bridge.ctn",
    ],
    "mbx0.sram": [ "sram_ctrl_main.ram" ],
    "mbx1.sram": [ "sram_ctrl_main.ram" ],
  },
}
